# ===================================================================
# Kisan Sathi Backend - Environment Configuration Template
# Copy this file to '.env' or export these environment variables.
# Do NOT commit your real '.env' file with sensitive passwords to Git!
# ===================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kisan_sathi_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security Configuration
# Secret key must be at least 256 bits (32+ characters) for HS256 algorithm
JWT_SECRET=YourSecureJwtSecretKeyMustBeAtLeast32CharactersLongForHS256!
JWT_EXPIRATION_MS=86400000

# External API Keys (Kept securely on backend, never exposed in client JS)
# WeatherAPI Key (Get free key from https://www.weatherapi.com/)
WEATHER_API_KEY=your_weather_api_key_here

# OpenRouter / LLM API Key (For Kisan Sathi AI Chatbot)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
